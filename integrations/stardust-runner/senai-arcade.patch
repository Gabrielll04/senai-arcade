+/* Testes da ponte com o SENAI Arcade (node src/core/arcade.test.js). */
+import { acaoDoLauncher, traduzirPorFase, lerEntrada } from './arcade.js';
+
+let falhas = 0;
+function confere(nome, obtido, esperado) {
+  const ok = JSON.stringify(obtido) === JSON.stringify(esperado);
+  if (!ok) falhas++;
+  console.log((ok ? '  ok   ' : '  FALHOU ') + nome + (ok ? '' : ` (obtido ${JSON.stringify(obtido)}, esperado ${JSON.stringify(esperado)})`));
+}
+
+console.log('\nponte SENAI Arcade');
+confere('left -> esquerda', acaoDoLauncher('left'), 'esquerda');
+confere('right -> direita', acaoDoLauncher('right'), 'direita');
+confere('up -> pular', acaoDoLauncher('up'), 'pular');
+confere('down -> deslizar', acaoDoLauncher('down'), 'deslizar');
+confere('action2 -> deslizar', acaoDoLauncher('action2'), 'deslizar');
+confere('confirm -> confirmar', acaoDoLauncher('confirm'), 'confirmar');
+confere('action1 -> confirmar', acaoDoLauncher('action1'), 'confirmar');
+confere('start -> confirmar', acaoDoLauncher('start'), 'confirmar');
+confere('back -> sair', acaoDoLauncher('back'), 'sair');
+confere('acao desconhecida -> null', acaoDoLauncher('help'), null);
+confere('nome herdado de Object -> null', acaoDoLauncher('toString'), null);
+
+confere('cima no attract comeca', traduzirPorFase('pular', 'attract'), 'confirmar');
+confere('cima no fim recomeca', traduzirPorFase('pular', 'fim'), 'confirmar');
+confere('cima correndo pula', traduzirPorFase('pular', 'jogando'), 'pular');
+confere('confirmar correndo pula', traduzirPorFase('confirmar', 'jogando'), 'pular');
+confere('confirmar no attract comeca', traduzirPorFase('confirmar', 'attract'), 'confirmar');
+confere('confirmar na pausa continua', traduzirPorFase('confirmar', 'pausa'), 'confirmar');
+
+const valida = { protocol: 'senai-arcade', version: 1, type: 'input', payload: { player: 1, action: 'up', phase: 'pressed' } };
+confere('mensagem valida', lerEntrada(valida), { jogador: 1, acao: 'up', fase: 'pressed' });
+confere('protocolo errado', lerEntrada({ ...valida, protocol: 'outro' }), null);
+confere('versao errada', lerEntrada({ ...valida, version: 2 }), null);
+confere('tipo errado', lerEntrada({ ...valida, type: 'ready' }), null);
+confere('jogador invalido', lerEntrada({ ...valida, payload: { ...valida.payload, player: 3 } }), null);
+confere('fase invalida', lerEntrada({ ...valida, payload: { ...valida.payload, phase: 'x' } }), null);
+confere('nulo', lerEntrada(null), null);
+
+if (falhas) {
+  console.log(`\n${falhas} FALHA(S)`);
+  process.exit(1);
+}
+console.log('\nTUDO CERTO');
