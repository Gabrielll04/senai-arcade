+/* ==========================================================================
+   SENAI ARCADE - ponte com o launcher do fliperama.
+
+   Quando o jogo roda DENTRO do SENAI Arcade (num iframe), quem le teclado,
+   encoder e gamepad e o launcher. Ele manda as entradas ja normalizadas por
+   window.postMessage (protocolo "senai-arcade" versao 1) e o jogo NAO pode
+   registrar listeners proprios de teclado/gamepad - senao cada tecla valeria
+   duas vezes.
+
+   Fora do launcher (aberto direto no navegador, server.js, pendrive) nada
+   aqui e ativado e o jogo segue exatamente como antes.
+
+   Protocolo: docs/ADDING-GAMES.md do repositorio senai-arcade.
+   ========================================================================== */
+
+export const PROTOCOLO = 'senai-arcade';
+export const VERSAO = 1;
+export const GAME_ID = 'stardust-runner';
+
+/** Maior pontuacao aceita pelo launcher na mensagem "score". */
+const PONTUACAO_MAXIMA = 1000000;
+
+function estaEmIframe() {
+  try {
+    return window.parent !== window;
+  } catch {
+    return true;
+  }
+}
+
+/** True quando o jogo foi aberto pelo SENAI Arcade. */
+export const modoArcade = typeof window !== 'undefined' && estaEmIframe();
+
+/**
+ * Acoes do launcher -> acoes do jogo.
+ * 'sair' e especial: pede para encerrar e voltar ao menu do fliperama.
+ */
+const MAPA_ARCADE = {
+  left: 'esquerda',
+  right: 'direita',
+  up: 'pular',
+  down: 'deslizar',
+  action2: 'deslizar',
+  confirm: 'confirmar',
+  action1: 'confirmar',
+  start: 'confirmar',
+  back: 'sair'
+};
+
+export function acaoDoLauncher(acaoLauncher) {
+  return Object.prototype.hasOwnProperty.call(MAPA_ARCADE, acaoLauncher)
+    ? MAPA_ARCADE[acaoLauncher]
+    : null;
+}
+
+/**
+ * "Cima" e "confirmar" fazem pulo OU inicio, conforme a fase:
+ * - nos menus (attract, fim), cima tambem comeca a partida;
+ * - durante a corrida, confirmar (botao A / Enter) tambem pula.
+ */
+export function traduzirPorFase(acao, fase) {
+  if (acao === 'pular' && (fase === 'attract' || fase === 'fim')) return 'confirmar';
+  if (acao === 'confirmar' && fase === 'jogando') return 'pular';
+  return acao;
+}
+
+/** Valida uma mensagem "input" do launcher. Devolve null se nao for valida. */
+export function lerEntrada(dados) {
+  if (!dados || typeof dados !== 'object') return null;
+  if (dados.protocol !== PROTOCOLO || dados.version !== VERSAO || dados.type !== 'input') return null;
+  const p = dados.payload;
+  if (!p || typeof p !== 'object') return null;
+  if (p.player !== 1 && p.player !== 2) return null;
+  if (p.phase !== 'pressed' && p.phase !== 'released') return null;
+  if (typeof p.action !== 'string') return null;
+  return { jogador: p.player, acao: p.action, fase: p.phase };
+}
+
+/** Envia uma mensagem ao launcher (somente para a janela pai, mesma origem). */
+export function enviarAoLauncher(type, payload) {
+  if (!modoArcade) return;
+  window.parent.postMessage({ protocol: PROTOCOLO, version: VERSAO, type, payload }, window.location.origin);
+}
+
+export function avisarPronto() {
+  enviarAoLauncher('ready', { gameId: GAME_ID });
+}
+
+export function avisarSaida(reason = 'user-request') {
+  enviarAoLauncher('exit', { reason });
+}
+
+export function enviarPontuacaoFinal(pontos) {
+  const valor = Math.max(0, Math.min(PONTUACAO_MAXIMA, Math.round(Number(pontos) || 0)));
+  enviarAoLauncher('score', { gameId: GAME_ID, scores: [{ player: 1, value: valor }] });
+}
+
+/**
+ * Escuta o launcher e entrega as acoes ja traduzidas.
+ * So reage a "pressed": o jogo trata cada acao como um toque.
+ * Devolve uma funcao que remove o listener.
+ */
+export function ouvirLauncher(aoAgir) {
+  const aoReceber = (ev) => {
+    if (ev.origin !== window.location.origin || ev.source !== window.parent) return;
+    const entrada = lerEntrada(ev.data);
+    if (!entrada || entrada.fase !== 'pressed') return;
+    const acao = acaoDoLauncher(entrada.acao);
+    if (acao) aoAgir(acao);
+  };
+  window.addEventListener('message', aoReceber);
+  return () => window.removeEventListener('message', aoReceber);
+}
