# SENAI Arcade — quiosque: Cage (compositor Wayland) exibindo apenas o Chromium.
# Baseado no exemplo "Starting Cage on boot with systemd" do projeto Cage.
# Instalado em /etc/systemd/system/ pelo scripts/install.sh.
# PENDENTE: validar no Raspberry Pi real (ver deploy/raspberry-pi/README.md).

[Unit]
Description=SENAI Arcade kiosk (Cage + Chromium) on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service nginx.service
Wants=nginx.service dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
# Ocupa o tty1 no lugar do prompt de login.
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/dev/tty1
# Evita laço infinito se algo estiver quebrado: no máx. 10 reinícios em 5 min.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=arcade
PAMName=senai-arcade-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# -d: sem decorações de janela. Sem -s: troca de terminal virtual (Ctrl+Alt+F*) desabilitada.
ExecStart=/usr/bin/cage -d -- /usr/local/bin/senai-arcade-browser
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
